# Erlbrew Café Messenger bot — configuration (see README.md)
# Copy to .env and fill in the values.  NEVER commit the real .env.

# --- Meta / Facebook -------------------------------------------------------
# App secret from the Meta App Dashboard (App settings > Basic)
APP_SECRET=replace_with_app_secret
# Any random string you invent; you also type this into the webhook settings
VERIFY_TOKEN=erlbrew_verify_token_2026
# Page Access Token from your Facebook Page (see README for steps)
PAGE_ACCESS_TOKEN=replace_with_page_access_token
GRAPH_VERSION=v23.0

# --- Admin -----------------------------------------------------------------
# Bearer-ish token used by POST /admin/unpause/{psid} (X-Admin-Token header)
ADMIN_TOKEN=change_me_admin_token

# --- Ollama (free local LLM).  Docker uses host-gateway for "host.docker.internal".
# If Ollama runs on another LAN box, e.g. http://192.168.1.20:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:2b
# "think" parameter for Ollama (false keeps answers short on weak CPUs)
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=30m

# --- POS menu (live prices during order intake) -----------------------------
# Read-only MySQL URL of the menu database, e.g.
#   mysql://botuser:botpass@192.168.1.20:3306/erlbrew_pos
# Leave empty to run the order form without live price quotes.
POS_MYSQL_URL=
MENU_CACHE_TTL_SEC=60

# --- Telegram notifications -----------------------------------------------
# Create a bot with @BotFather, then chat id via the getUpdates API (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Behaviour -------------------------------------------------------------
# How fast the team answers new event bookings (told to the customer)
EVENT_REPLY_HOURS=24

# SQLite database (inside the container this lives on the ./data volume)
DB_PATH=data/erlbrew.db
# Editable files (mounted as ./data volume in docker-compose, editable live)
FAQ_PATH=data/faq.yaml
KNOWLEDGE_PATH=data/knowledge.md

# Rate limiting: 15 messages / 10 minutes, max 500 chars per message
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_SEC=600
MAX_TEXT_CHARS=500

# LLM fallback
LLM_TIMEOUT_SEC=25

# Misc
PORT=8000
LOG_LEVEL=INFO
